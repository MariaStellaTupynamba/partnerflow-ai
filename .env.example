# Copy this file to `.env` and fill in real values for local development.
# Never commit the resulting `.env` file — it is already git-ignored.
# All values below are placeholders / fictional and safe to keep in version control.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (used directly by docker-compose to create the database) ---
POSTGRES_USER=partnerflow
POSTGRES_PASSWORD=partnerflow-dev-password
POSTGRES_DB=partnerflow

# --- Backend (apps/api) ---
# Used when running the API directly on the host (outside Docker Compose).
# When running via `docker compose up`, this is overridden to point at the `db` service.
DATABASE_URL=postgresql+psycopg://partnerflow:partnerflow-dev-password@localhost:5432/partnerflow

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-never-commit-a-real-one
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON array of allowed origins for CORS.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# AI provider abstraction — any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, a self-hosted
# gateway, etc.). Leave AI_PROVIDER_API_KEY empty in development if you are not exercising AI
# features yet; the provider is not called by any endpoint in this milestone.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
